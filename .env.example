# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth App (sign-in gate only). One app works for both: add the localhost and
# https://pulse.semere.app callback URLs (/api/auth/callback/github) as redirect URIs.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed to sign in
ALLOWED_USERS=semere-wazza

# Name shown in exported reports (Settings → Report overrides it)
REPORT_NAME=Semere Talegngeta

# Classic PAT, read-only scopes: repo, read:org, read:user. Used for all GitHub data + cron.
GITHUB_PAT=

# Neon Postgres
DATABASE_URL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# AI summary: set the key for whichever provider you pick in Settings → AI summary.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GitHub Models: fine-grained token with Models: read (falls back to GITHUB_PAT)
GITHUB_MODELS_TOKEN=

# Email via Resend: paused, not built yet.
# RESEND_API_KEY=
# REPORT_EMAIL_FROM=pulse@semere.app
# REPORT_EMAIL_TO=
