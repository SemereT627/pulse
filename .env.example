# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth App. Anyone can sign in; their sign-in token (repo, read:org, read:user) reads their own activity.
# One app works for local and production: add both callback URLs (/api/auth/callback/github) as redirect URIs.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Encrypts users' GitHub tokens and AI keys at rest. 32 bytes, base64: openssl rand -base64 32
# Changing it makes every stored token and key unreadable (users would sign in and re-enter keys).
ENCRYPTION_KEY=

# Neon Postgres
DATABASE_URL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# AI keys are per user, entered in Settings → AI summary; none are read from env.

# Email via Resend: paused, not built yet.
# RESEND_API_KEY=
# REPORT_EMAIL_FROM=pulse@semere.app
# REPORT_EMAIL_TO=
