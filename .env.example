# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth App (sign-in gate only). Separate apps for localhost and pulse.semere.app.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed to sign in
ALLOWED_USERS=semere-wazza

# Classic PAT, read-only scopes: repo, read:org, read:user. Used for all GitHub data + cron.
GITHUB_PAT=

# Neon Postgres
DATABASE_URL=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Optional AI narrative
AI_ENABLED=false
ANTHROPIC_API_KEY=

# Optional email via Resend
RESEND_API_KEY=
REPORT_EMAIL_FROM=pulse@semere.app
REPORT_EMAIL_TO=
